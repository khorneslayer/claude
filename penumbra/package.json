{
  "name": "penumbra",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @penumbra/server --filter @penumbra/client dev",
    "feed": "pnpm --filter @penumbra/server start",
    "frame": "tsx apps/server/src/frame-cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/client/tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm test",
    "client": "pnpm --filter @penumbra/client dev",
    "build": "pnpm --filter @penumbra/client build",
    "shot": "pnpm --filter @penumbra/client shot",
    "smoke": "pnpm --filter @penumbra/client smoke",
    "probe:report": "tsx apps/server/src/probe-report.ts",
    "probe:smoke": "pnpm --filter @penumbra/client probe:smoke",
    "demo": "pnpm --parallel --filter @penumbra/server --filter @penumbra/client demo",
    "demo:record": "node apps/client/scripts/record-demo.mjs",
    "probe": "pnpm dev",
    "manual": "node docs/manual/build.mjs"
  },
  "devDependencies": {
    "@fontsource/anton": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@types/node": "26.6.6",
    "@types/ws": "8.18.2",
    "fast-check": "4.10.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
